# ProspectIQ environment configuration — copy this to .env and fill in your values
# cp .env.example .env

# Primary Overpass API endpoint
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Fallback mirrors (comma-separated)
OVERPASS_MIRRORS=https://overpass.kumi.systems/api/interpreter,https://overpass.openstreetmap.ru/api/interpreter

# SQLite database path
DATABASE_PATH=data/prospectiq.db

# REQUIRED: replace with a real contact email for the User-Agent header
USER_AGENT=ProspectIQ/0.2 (Nairobi business research; contact: your-email@example.com)

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/prospectiq.log

# Comma-separated browser origins allowed to call the API
FRONTEND_ORIGINS=http://localhost:6060,http://localhost:5173,http://localhost:3000
